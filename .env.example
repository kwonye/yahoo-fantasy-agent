YAHOO_CLIENT_ID=your_yahoo_client_id
YAHOO_CLIENT_SECRET=your_yahoo_client_secret
YAHOO_REDIRECT_URI=oob
# Optional. By default the token is kept in the user's config directory.
# YAHOO_TOKEN_PATH=/absolute/path/to/yahoo-fantasy-mcp-token.json

# Optional MCP v2 Streamable HTTP server settings.
# The CLI remains stdio by default; use `yahoo-fantasy-mcp serve --transport http`.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000
MCP_HTTP_PATH=/mcp
MCP_HTTP_RESPONSE_MODE=auto
# Set this when intentionally binding beyond loopback. It is also accepted for
# local HTTP use and is never accepted as a command-line argument.
# MCP_HTTP_TOKEN=replace-with-a-long-random-token
# For non-loopback binds, list hostnames accepted in Host headers.
# MCP_HTTP_ALLOWED_HOSTS=mcp.example.com
# Optional browser Origin hostnames; requests without Origin are allowed.
# MCP_HTTP_ALLOWED_ORIGINS=mcp.example.com

# Optional shared configuration/token/journal directory for published CLI and plugin.
# Portable hosts set this from PLUGIN_DATA; use the diagnosed directory for auth.
# YAHOO_FANTASY_DATA_DIR=/absolute/private/yahoo-fantasy-mcp
